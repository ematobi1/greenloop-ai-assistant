{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "greenloop/contracts/model-list.schema.json",
  "title": "ModelList",
  "type": "object",
  "additionalProperties": false,
  "required": ["data", "meta"],
  "properties": {
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "model", "default"],
        "properties": {
          "provider": { "type": "string", "minLength": 1 },
          "model": { "type": "string", "minLength": 1 },
          "default": { "type": "boolean" }
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total"],
      "properties": { "total": { "type": "integer", "minimum": 0 } }
    }
  }
}
