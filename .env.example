GREENLOOP_ENV=development
GREENLOOP_LOG_LEVEL=INFO
GREENLOOP_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
GREENLOOP_ALLOWED_HOSTS=["127.0.0.1","localhost"]
# SHA-256 hash of the API token. scripts\new-token.ps1 generates the token and fills this in.
# Empty means every protected endpoint returns 401.
GREENLOOP_API_TOKEN_HASH=
# Defaults to <repo>/data/greenloop.db when unset
# GREENLOOP_DATABASE_URL=sqlite:///C:/path/to/greenloop.db
